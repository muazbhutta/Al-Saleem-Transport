# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
# Alternate build dirs from NEXT_DIST_DIR (see next.config.mjs) — used to build
# without corrupting a running dev server's cache.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# scratch output from `npm run gen:qr` (the generated qr-codes.ts IS committed)
/.qr-tmp

# `npm run gen:og` output — regenerable, and not the asset the site serves
# (og-default.jpg is the shipped card).
/public/og/og-generated.jpg

# Claude Code local config
.claude/
