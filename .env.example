# Public site URL — used for canonical tags, sitemap, hreflang, Open Graph, JSON-LD.
# Optional: when unset, production deployments fall back to the hard-coded
# production domain (see productionUrl in src/lib/site.ts), Vercel previews use
# their own VERCEL_URL, and local dev uses http://localhost:3000.
# Set it only to override — e.g. https://www.alsaleemtransport.com
NEXT_PUBLIC_SITE_URL=

# Google Gemini API key for the on-site assistant (/api/chat).
# Free tier: create a key at https://aistudio.google.com/apikey
# Server-side only — never exposed to the browser. Leave blank to disable the bot.
GEMINI_API_KEY=

# --- Google Ads conversion tracking -----------------------------------------
# Both values are public (they ship in the page source); they are not secrets.
#
# Google tag ID — Google Ads → Admin → Data sources → Google tag.
# The base gtag.js snippet is only rendered when this is set, so leaving it
# blank disables tracking entirely (local dev, preview deployments).
NEXT_PUBLIC_GADS_ID=AW-18381091753

# Send-to label for the "Contact" (Click) conversion action —
# Google Ads → Goals → Conversions → Contact → Tag setup → event snippet.
# Format: AW-XXXXXXXXX/YYYYYYYYYYYYYYYY
NEXT_PUBLIC_GADS_CONTACT_LABEL=AW-18381091753/Vn2fCIb4uOAcEKnn5LxE
