# Public site URL — used for canonical tags, sitemap, hreflang, Open Graph.
# In production set this to your live domain, e.g. https://alsaleemtransport.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API key for the on-site assistant (/api/chat).
# Free tier: create a key at https://aistudio.google.com/apikey
# Server-side only — never exposed to the browser. Leave blank to disable the bot.
GEMINI_API_KEY=
